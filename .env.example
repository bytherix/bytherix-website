# Base URL of the Bytherix API used by account registration/login.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Optional: endpoint that receives contact-form submissions (POST, JSON).
# Leave empty when no delivery backend exists. The contact form then shows the
# fallback email/phone instead of silently pretending the message was sent.
VITE_CONTACT_ENDPOINT=
